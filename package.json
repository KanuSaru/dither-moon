{
  "name": "dither-moon",
  "version": "1.2.0",
  "description": "The Moon at its real phase, drawn as 1-bit dithered pixel art. A custom element, a React component and the phase math.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./dist/dither-moon.js": "./dist/dither-moon.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "./src/browser.js",
    "./dist/dither-moon.js"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "esbuild src/browser.js --bundle --format=iife --minify --target=es2020 --legal-comments=none --outfile=dist/dither-moon.js"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "keywords": [
    "moon",
    "moon-phase",
    "lunar",
    "dither",
    "pixel-art",
    "1-bit",
    "web-component",
    "react",
    "canvas"
  ],
  "author": "Erick Donado (https://github.com/KanuSaru)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KanuSaru/dither-moon.git"
  },
  "homepage": "https://github.com/KanuSaru/dither-moon#readme"
}
